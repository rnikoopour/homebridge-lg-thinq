{
  "displayName": "Homebridge LG ThinQ",
  "name": "@rnikoopour/homebridge-lg-thinq",
  "version": "2.0.0",
  "description": "A Homebridge plugin for controlling/monitoring LG ThinQ device via LG ThinQ platform.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rnikoopour/homebridge-lg-thinq.git"
  },
  "bugs": {
    "url": "https://github.com/rnikoopour/homebridge-lg-thinq/issues"
  },
  "engines": {
    "node": "^22.12.0 || ^24 || ^26",
    "homebridge": "^2.0.0"
  },
  "main": "dist/index.js",
  "bin": {
    "thinq": "./dist/cli.js"
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "homebridge-plugin",
    "homekit",
    "lg",
    "lg-thinq"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "homebridge": "^2.5.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "homepage": "https://github.com/rnikoopour/homebridge-lg-thinq#readme",
  "author": {
    "name": "rnikoopour",
    "url": "https://github.com/rnikoopour"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.7",
    "aws-iot-device-sdk": "^2.2.11",
    "axios": "^1.21.0",
    "axios-retry": "^4.5.0",
    "commander": "^8.2.0",
    "luxon": "^3.7.2",
    "node-forge": "^1.4.2",
    "node-persist": "^0.0.11",
    "qs": "^6.17.1"
  },
  "contributors": [
    {
      "name": "nVuln",
